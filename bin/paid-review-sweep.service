[Unit]
Description=PAID — sweep stale review sessions (auto-close inactive >24h)
After=hermes-gateway.service

[Service]
Type=oneshot
WorkingDirectory=%h/.hermes/plugins/paid-v1
ExecStart=%h/.hermes/hermes-agent/venv/bin/python bin/sweep_review_sessions.py
StandardOutput=append:%h/.hermes/paid/sweep_review.log
StandardError=append:%h/.hermes/paid/sweep_review.log

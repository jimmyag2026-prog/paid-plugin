[Unit]
Description=PAID — daily snapshot rollup (today's activity → daily/<date>.md)
After=hermes-gateway.service

[Service]
Type=oneshot
WorkingDirectory=%h/.hermes/plugins/paid-v1
ExecStart=%h/.hermes/hermes-agent/venv/bin/python bin/daily_snapshot.py
StandardOutput=append:%h/.hermes/paid/daily_snapshot.log
StandardError=append:%h/.hermes/paid/daily_snapshot.log
